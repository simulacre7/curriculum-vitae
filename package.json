{
  "name": "curriculum-vitae",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-og-images.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .tmp-ssr --emptyOutDir true && node scripts/build-og-pages.mjs && node scripts/prerender-cv-pages.mjs && node scripts/build-bash-pdf.mjs",
    "build:og-images": "node scripts/generate-og-images.mjs",
    "build:case-study-pdf": "node scripts/build-case-study-pdf.mjs",
    "build:submission-pdf": "node scripts/build-submission-pdf.mjs",
    "audit:performance": "pnpm build && node scripts/audit-performance.mjs",
    "audit:lighthouse": "pnpm build && node scripts/audit-lighthouse.mjs",
    "audit:site": "pnpm build && node scripts/audit-performance.mjs && node scripts/audit-lighthouse.mjs",
    "format": "prettier --write .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.11.4",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.11.5",
    "i18next": "^23.11.5",
    "just-bash": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@puppeteer/browsers": "2.13.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "lighthouse": "^13.3.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.3.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
